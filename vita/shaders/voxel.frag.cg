/**
 * RustCraft – Voxel Fragment Shader (Cg / psp2cgc)
 * Kompilacja: psp2cgc -profile sce_fp_psp2 voxel.frag.cg -o voxel.frag.gxp
 */
float4 main(
    float2  oUV  : TEXCOORD0,
    float   oAO  : TEXCOORD1,
    float   oFog : TEXCOORD2,

    uniform sampler2D uTexture
) : COLOR
{
    float4 color = tex2D(uTexture, oUV);
    if (color.a < 0.05f) {
        if (oFog < 0.18f) {
            discard;
        }
        color = float4(0.08f, 0.18f, 0.06f, 1.0f);
    }
    // Ambient Occlusion + color + distance fog blend
    float3 lit = color.rgb * oAO;
    float3 sky_color = float3(0.443f, 0.702f, 0.949f);
    return float4(lerp(lit, sky_color, oFog), color.a);
}
