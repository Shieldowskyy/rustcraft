/**
 * RustCraft – Voxel Vertex Shader (Cg / psp2cgc)
 * Compilation: psp2cgc -profile sce_vp_psp2 voxel.vert.cg -o voxel.vert.gxp
 *
 * MATRIX LAYOUT (PS Vita Cg):
 *   - GXM passes column-major matrices (m[col*4+row])
 *   - Cg mul(v, M): row-vector × column-major matrix = M*v (correct!)
 *   - Cg mul(M, v): column-major × column-vector = TRANSPOSED (incorrect!)
 *   - SDL2/GXM uses mul(pos, wvp) — identically to below.
 */
void main(
    float3  aPosition : POSITION,
    float2  aUV       : TEXCOORD0,
    float   aAO       : TEXCOORD1,

    uniform float4x4 uViewProj,
    uniform float4   uCameraPosAndFog,

    float4  out oPosition : POSITION,
    float2  out oUV       : TEXCOORD0,
    float   out oAO       : TEXCOORD1,
    float   out oFog      : TEXCOORD2
)
{
    oPosition = mul(float4(aPosition, 1.0f), uViewProj);
    oUV       = aUV;
    oAO       = aAO;

    float max_fog = uCameraPosAndFog.w;
    if (max_fog > 0.0f) {
        float dist = distance(aPosition, uCameraPosAndFog.xyz);
        float fog_start = max_fog * 0.45f;
        oFog = saturate((dist - fog_start) / max(max_fog - fog_start, 1.0f));
    } else {
        oFog = 0.0f;
    }
}
