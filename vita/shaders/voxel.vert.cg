/**
 * RustCraft – Voxel Vertex Shader (Cg / psp2cgc)
 * Kompilacja: psp2cgc -profile sce_vp_psp2 voxel.vert.cg -o voxel.vert.gxp
 *
 * UKŁAD MACIERZY (PS Vita Cg):
 *   - GXM wysyła macierze column-major (m[col*4+row])
 *   - Cg mul(v, M): row-vector × column-major matrix = M*v (poprawne!)
 *   - Cg mul(M, v): column-major × column-vector = TRANSPONOWANE (błąd!)
 *   - SDL2/GXM używa mul(pos, wvp) — identycznie jak poniżej.
 */
void main(
    float3  aPosition : POSITION,
    float2  aUV       : TEXCOORD0,
    float   aAO       : TEXCOORD1,

    uniform float4x4 uViewProj,

    float4  out oPosition : POSITION,
    float2  out oUV       : TEXCOORD0,
    float   out oAO       : TEXCOORD1
)
{
    oPosition = mul(float4(aPosition, 1.0f), uViewProj);
    oUV       = aUV;
    oAO       = aAO;
}
